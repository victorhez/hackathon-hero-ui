# ──────────────────────────────────────────────────────────────────────
# ClearLend — Cleanverse sandbox credentials
# Copy this file to `.env.local` and fill real values before running locally.
# NEVER commit the real .env.local file.
#
# Configure these in Vercel Project Settings → Environment Variables:
#   CLEANVERSE_BASE_URL, CLEANVERSE_API_ID, CLEANVERSE_API_KEY
# ──────────────────────────────────────────────────────────────────────

# Cleanverse API base (sandbox). Override in prod for mainnet/prod account.
CLEANVERSE_BASE_URL=https://api.cleanverse.com

# Sandbox API Id & key — provided by Cleanverse hackathon portal.
# These authenticate server-side only — NEVER expose to the browser.
CLEANVERSE_API_ID=APP20260614112550LIDZXM
CLEANVERSE_API_KEY=your_api_key_here

# Docs access code (not used at runtime — only for reading integration docs)
CLEANVERSE_DOCS_CODE=your_docs_code_here

# Default chain for the app — ClearLend was designed for Base first.
APP_NETWORK=Base

# Public site URL (optional — used when building absolute links).
# Leave blank in dev; Vercel sets VERCEL_URL automatically on deploy.
SITE_URL=

# Optional: feature flag — set 0 to disable demo shortcuts on prod-like mode.
APP_DEMO_SHORTCUTS_ENABLED=1
